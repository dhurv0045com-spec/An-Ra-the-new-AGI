{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anra-discovery-gym/protocol/v2",
  "type": "object",
  "required": [
    "schema",
    "protocol_id",
    "stage",
    "hypothesis",
    "generator_version",
    "suite_manifest_sha256",
    "split_contract",
    "policy_ids",
    "baseline_ids",
    "budget",
    "equal_action_budget",
    "primary_metrics",
    "secondary_metrics",
    "prospective_thresholds",
    "confirmation_policy",
    "tuning_policy",
    "model_status",
    "attribution_policy"
  ],
  "properties": {
    "schema": {"const": "anra-discovery-gym/protocol/v2"},
    "protocol_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "generator_version": {"type": "string", "minLength": 1},
    "suite_manifest_sha256": {"type": "string", "minLength": 1},
    "split_contract": {"type": "object"},
    "policy_ids": {"type": "array", "items": {"type": "string"}},
    "baseline_ids": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "integer", "minimum": 1},
    "equal_action_budget": {"const": true},
    "primary_metrics": {"type": "array", "items": {"type": "string"}},
    "secondary_metrics": {"type": "array", "items": {"type": "string"}},
    "prospective_thresholds": {"type": "object"},
    "confirmation_policy": {"type": "string", "minLength": 1},
    "tuning_policy": {"type": "string", "minLength": 1},
    "model_status": {"type": "string", "minLength": 1},
    "attribution_policy": {"type": "string", "minLength": 1},
    "protocol_sha256": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

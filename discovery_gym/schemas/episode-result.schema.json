{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anra-discovery-gym/episode-result/v1",
  "type": "object",
  "required": [
    "schema",
    "episode_id",
    "world_id",
    "independence_unit",
    "policy_id",
    "uses_hidden_truth",
    "budget",
    "total_cost",
    "experiment_cost",
    "invalid_cost",
    "invalid_action_count",
    "budget_overrun",
    "final_answer",
    "success",
    "prediction_rows",
    "events",
    "commitments",
    "evaluator_recomputation",
    "legality_recomputation",
    "component_attribution"
  ],
  "properties": {
    "schema": {"const": "anra-discovery-gym/episode-result/v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "pattern": "^dgw-[0-9a-f]+$"},
    "independence_unit": {"const": "latent_world"},
    "split": {"type": "string"},
    "structure_id": {"type": "string"},
    "policy_id": {"type": "string", "minLength": 1},
    "uses_hidden_truth": {"type": "boolean"},
    "budget": {"type": "integer", "minimum": 1},
    "total_cost": {"type": "integer", "minimum": 0},
    "experiment_cost": {"type": "integer", "minimum": 0},
    "invalid_cost": {"type": "integer", "minimum": 0},
    "experiment_count": {"type": "integer", "minimum": 0},
    "invalid_action_count": {"type": "integer", "minimum": 0},
    "budget_overrun": {"type": "boolean"},
    "final_answer": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "success": {"type": "boolean"},
    "abstained": {"type": "boolean"},
    "prediction_rows": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "commitments": {"type": "array", "items": {"type": "object"}},
    "evaluator_recomputation": {"type": "object"},
    "legality_recomputation": {"type": "object"},
    "component_attribution": {"type": "object"}
  },
  "additionalProperties": true
}

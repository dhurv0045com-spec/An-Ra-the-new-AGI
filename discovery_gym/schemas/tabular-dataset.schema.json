{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anra-discovery-gym/tabular-dataset/v1",
  "type": "object",
  "required": ["name", "columns", "rows", "source_sha256"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": "string"}}},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}

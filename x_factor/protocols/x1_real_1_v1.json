{
  "schema": "anra-x1-real-1-protocol/v1",
  "brand": "euler",
  "version": 1,
  "phase": "FROZEN_TEMPLATE",
  "authority": {
    "real_model_spec": "x_factor/REAL_MODEL_CAUSAL_SPEC.md",
    "synthetic_spec": "x_factor/SPEC.md",
    "program_ledger": "AN_RA_PROGRAM.md",
    "real_claims_only": true,
    "low_rank_assumption": false,
    "geometry": "open; response diversity is tested in the high-diversity tail of sparsity-matched global, column-marginal, row-marginal, and cluster-marginal nulls; compressibility is reported separately and is not a rank assumption"
  },
  "claim_ceiling": "A positive result supports prospective intervention selection in the tested real-model regime only. It does not establish general intelligence, general self-improvement, successful internalization, or architecture-independent cognition.",
  "execution_boundary": {
    "local_model_execution": false,
    "local_training": false,
    "package_role": "model_free_receipt_coordinator",
    "external_execution_required": true,
    "sealed_data_access": false,
    "weights_download": false
  },
  "power_policy": {
    "target_clusters_are_preferred": true,
    "minimum_clusters_are_hard_gate": true,
    "below_target_requires_explicit_deviation": true,
    "underpowered_runs_must_be_labeled": true
  },
  "preflight_contract": {
    "schema": "anra-x1-real-1-preflight/v1",
    "required_before_external_execution": true,
    "dry_run_forbidden_operations": ["local_model_execution", "local_training"],
    "transformation_smoke_required": true,
    "candidate_intake_required": true,
    "candidate_intake_schema": "anra-x1-real-1-candidate-intake/v1",
    "platform_profiles": ["COLAB", "KAGGLE", "PERSISTENT_GPU_RUNNER"],
    "failure_policy": "BLOCKED"
  },
  "subject_binding": {
    "manifest_schema": "anra-x1-real-1-subject/v1",
    "required_identity_fields": [
      "checkpoint_file_sha256",
      "parameter_sha256",
      "model_config_sha256",
      "tokenizer_artifact_sha256",
      "tokenizer_identity_sha256",
      "runtime_source_revision",
      "source_commit",
      "identity_attestation_path",
      "identity_attestation_sha256"
    ],
    "research_subject_required": true,
    "eligible_states": ["READY_SCOPED", "READY", "QUALIFIED"],
    "historical_controls_are_subjects": false,
    "registry_entry_required": true,
    "eligibility_artifacts_file_verified": true,
    "release_manifest_required": true,
    "basis_qualification_before_predictor_training": true
  },
  "interventions": [
    {
      "id": "NO_CHANGE",
      "version": 1,
      "family": "no_change",
      "role": "NULL_CONTROL",
      "assistance": "A0",
      "cost": 0,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "identity",
      "transformation_id": "identity",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Return the original visible task unchanged; cost unit is one abstract intervention unit."
    },
    {
      "id": "NULL_REFORMAT",
      "version": 2,
      "family": "surface_control",
      "role": "NULL_CONTROL",
      "assistance": "A0",
      "cost": 0,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_null_reformat",
      "transformation_id": "null_reformat_v2",
      "control_pair": "NO_CHANGE",
      "preserves_task_answer_information": true,
      "semantics": "Apply semantics-preserving whitespace and label churn; this is the matched sham control."
    },
    {
      "id": "QUERY_DUPLICATION",
      "version": 2,
      "family": "query_salience",
      "role": "DIAGNOSTIC",
      "assistance": "A0",
      "cost": 0,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_query_duplication",
      "transformation_id": "query_duplication_v2",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Repeat the visible query once before the answer marker without adding answer information."
    },
    {
      "id": "QUERY_FRONTLOAD",
      "version": 2,
      "family": "query_salience",
      "role": "DIAGNOSTIC",
      "assistance": "A1",
      "cost": 1,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_query_frontload",
      "transformation_id": "query_frontload_v2",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Place one copy of the visible query before the facts and retain the original query after the facts."
    },
    {
      "id": "CANONICAL_CONTEXT",
      "version": 2,
      "family": "context_structure",
      "role": "REPAIR",
      "assistance": "A1",
      "cost": 1,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_canonical_context",
      "transformation_id": "canonical_context_v2",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Render the visible facts as a deterministic sorted item list without changing their contents."
    },
    {
      "id": "REALIZATION_ENVELOPE",
      "version": 2,
      "family": "realization_support",
      "role": "REPAIR",
      "assistance": "A1",
      "cost": 1,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_realization_envelope",
      "transformation_id": "realization_envelope_v2",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Add a fixed output-format envelope using only the visible task and answer-format instruction."
    },
    {
      "id": "STATE_TABLE",
      "version": 2,
      "family": "state_externalization",
      "role": "REPAIR",
      "assistance": "A3",
      "cost": 2,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_state_table",
      "transformation_id": "state_table_v2",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Re-express the visible facts as a deterministic state table; no fact is selected using truth."
    },
    {
      "id": "LEXICAL_ADDRESSING_HINT",
      "version": 2,
      "family": "addressing_support",
      "role": "REPAIR",
      "assistance": "A2",
      "cost": 2,
      "information_class": "INFORMATION_PRESERVING",
      "legality_inputs": ["visible_context", "visible_query", "visible_candidates", "visible_format"],
      "transformation": "ibq_v2._t_lexical_hint",
      "transformation_id": "lexical_addressing_hint_v2",
      "control_pair": "NULL_REFORMAT",
      "preserves_task_answer_information": true,
      "semantics": "Mark visible entities sharing lexical tokens with the visible query; never consult the answer or evaluator metadata."
    }
  ],
  "intervention_registry_sha256": "13794e0378b0eaaa0bb447e6b9c7e7bef76a8a4cf2caf5c26e89f99a93adb56a",
  "cost_model": {
    "unit": "abstract_intervention_unit",
    "all_costs_predeclared": true,
    "utility_lambda": 0.25,
    "wall_clock_or_currency_claim": false
  },
  "execution_budget": {
    "primary_cells": 960,
    "replication_cells": 960,
    "maximum_external_cells": 1920,
    "cell_definition": "one independent-cluster task times one frozen intervention",
    "cell_budget_fail_closed": true,
    "local_execution_authorized": false,
    "budget_status": "EXTERNAL_OPERATOR_AUTHORIZATION_REQUIRED"
  },
  "cohorts": {
    "basis_qualification": {

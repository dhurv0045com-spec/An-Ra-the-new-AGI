      "cohort_plan_sha256": "21c186b22edaf60abd0387fa2b2ed29104b8a13f953be1250a58bc7b15663336",
      "target_independent_clusters": 60,
      "minimum_independent_clusters": 20,
      "purpose": "pre-training intervention-basis qualification; disjoint from development and evaluation"
    },
    "development": {
      "cohort_id": "DEV_COHORT_V1",
      "role": "DEVELOPMENT",
      "seed": 81818,
      "cohort_plan_sha256": "f69d9f14fc97dba864c4e7d29d1151ffb141d7a9a11b86d04c427b856afcbb56",
      "target_independent_clusters": 60,
      "minimum_independent_clusters": 20,
      "purpose": "fit the frozen predictor and development-only fixed baselines"
    },
    "primary": {
      "cohort_id": "PRIMARY_EVAL",
      "role": "EVALUATION",
      "seed": 81819,
      "cohort_plan_sha256": "3aa54d2ec406cd0d7b7576ea991833c03658ba58b8ab17a289eab77b97ac55bb",
      "target_independent_clusters": 120,
      "minimum_independent_clusters": 40,
      "purpose": "first prospective evaluation after prediction commitment"
    },
    "independent_task": {
      "cohort_id": "INDEPENDENT_TASK_EVAL",
      "role": "EVALUATION",
      "seed": 81820,
      "cohort_plan_sha256": "cf4123533170fbe535c70c385d184ec76064b732a2ce9e892f1686c8a6744213",
      "target_independent_clusters": 120,
      "minimum_independent_clusters": 40,
      "purpose": "independent task/source cohort; no predictor or threshold fitting"
    },
    "checkpoint_replication": {
      "cohort_id": "CHECKPOINT_REPLICATION",
      "role": "REPLICATION",
      "seed": 81821,
      "cohort_plan_sha256": "6459c5107121766a4ac65db8b6d7f83b1b51bfd5fde368089a6ae78956948e29",
      "target_independent_clusters": 120,
      "minimum_independent_clusters": 40,
      "purpose": "cross-checkpoint replication under the same frozen scientific contract"
    }
  },
  "splits": {
    "statistical_unit": "independent_latent_world_or_source_cluster",
    "task_intervention_rows_are_paired_repeated_measures": true,
    "cluster_overlap_between_splits": "forbidden",
    "source_overlap_between_evaluation_splits": "forbidden",
    "split_manifest_schema": "anra-x1-real-1-split/v1",
    "task_ids_must_be_opaque": true,
    "task_content_sha256s_required_per_cluster": true,
    "repeated_prompts_are_not_independent_units": true
  },
  "observations": {
    "closed_schema": true,
    "public_task_fields": ["task_id", "context", "query", "visible_candidates", "format", "features"],
    "feature_fields": ["confidence", "entropy", "margin", "output_len", "distinct_ratio", "prompt_tokens"],
    "forbidden_fields": ["gold", "gold_answer", "correctness", "correctness_label", "family", "family_id", "cluster_id", "source_id", "world_id", "oracle", "intervention_outcome", "outcomes", "effect", "raw_output", "verifier"],
    "prediction_receipt_before_reveal": true,
    "nested_serialized_record_audit": true,
    "policy_visible_input_is_physically_separate_from_evaluator_truth": true
  },
  "predictor": {
    "name": "externally_frozen_observed_only_predictor",
    "training_cohort": "DEV_COHORT_V1",
    "training_procedure": "fit on development outcomes only, grouped by independent latent world/source cluster, with numeric feature standardization and a preregistered regularized independent Bernoulli repair model; no gold labels, family identity, or evaluation outcomes enter the feature vector",
    "evaluation_procedure": "produce one calibrated repair probability per legal intervention for every primary evaluation task before any intervention outcome is revealed",
    "feature_order": ["confidence", "entropy", "margin", "output_len", "distinct_ratio", "prompt_tokens"],
    "low_rank_required": false,
    "out_of_support_action": "abstain or select NO_CHANGE; do not claim a repair",
    "source_identity_required": true,
    "training_artifact_hash_required": true
  },
  "baselines": [
    "ALWAYS_NEGATIVE",
    "PREVALENCE_ONLY",
    "BEST_FIXED_DEV",
    "COST_AWARE_FIXED",
    "SURFACE_SHORTCUT",
    "SPARSITY_RANDOM"
  ],
  "metrics": {
    "cell_level": ["cluster-macro AUPRC", "cluster-macro AUPRC_lift_over_prevalence", "cluster-macro Brier_skill_vs_development_prevalence", "cluster-macro calibration_error", "cluster-macro MCC", "raw_accuracy_diagnostic_only"],
    "task_level": ["repair_capture", "false_intervention_rate", "intervention_regret", "repair_lift_over_no_change", "cost_adjusted_utility", "mean_excess_cost_vs_oracle"],
    "uncertainty": "paired bootstrap resampling of independent latent world/source clusters; reported policy means and utility promotion use cluster-weighted means, with task-weighted values retained as diagnostics; utility promotion requires a preregistered lower CI above zero",
    "null_control": "high-diversity-tail comparison against sparsity-matched global, column-marginal, row-marginal, and cluster-marginal response matrices; low-entropy compressibility is diagnostic only",
    "oracle": "evaluator-only ceiling; never a policy input or baseline prediction"
  },
  "decision_thresholds": {
    "basis": {
      "min_oracle_coverage": 0.15,
      "min_active_prevalence": 0.03,
      "max_active_prevalence": 0.90,
      "max_pairwise_redundancy": 0.40,
      "min_signature_entropy_bits": 0.50,
      "min_unique_signatures": 4,
      "min_failures": 40,
      "explicit_failure_required": true,
      "min_independent_clusters": 20,
      "max_null_p_value": 0.05,
      "max_no_change_repair_rate": 0.05,
      "max_control_excess_rate": 0.10,
      "null_resamples": 200,
      "null_seed": 81818
    },
  "predictor": {
      "cost_lambda": 0.25,
      "min_auprc_lift": 0.10,
      "min_brier_skill": 0.05,
      "max_calibration_error": 0.10,
      "min_mcc": 0.05,
      "min_repair_lift": 0.05,
      "min_utility_margin": 0.0,
      "require_ci_above_zero": true,
      "min_score_variance": 0.000001,
      "min_independent_clusters": 40,
      "bootstrap_resamples": 2000,
      "bootstrap_seed": 81818,
      "primary_gate_requires": ["calibration", "AUPRC_lift", "Brier_skill", "MCC", "cost_adjusted_utility", "best_fixed", "cost_aware_fixed", "surface_shortcut", "repair_lift", "independent_clusters"]
    },
    "replication": {
      "independent_task_cohort_required": true,
      "cross_checkpoint_required": true,
      "same_seed_forbidden": true,
      "same_cohort_forbidden": true
    }
  },
  "release_binding": {
    "release_revision_required": true,
    "protocol_artifact_must_match_supplied_protocol": true,
    "attestation_artifact_required": true
  },
  "custody_phases": ["BASIS_QUALIFIED", "PREDICT_COMMITTED", "REVEAL_ACCEPTED"],
  "prediction_parent_phase": "BASIS_QUALIFIED",
  "reveal_evidence": {
    "required_row_fields": [
      "task_id", "intervention_id", "cluster_id", "source_id", "repaired", "baseline_failed", "effect",
      "raw_output_sha256", "verifier_receipt_sha256", "gold_sha256", "transformed_prompt_sha256",
      "transformed_prompt", "verifier_artifact_path", "verifier_artifact_sha256"
    ],
    "verifier_artifact_rule": "Each revealed row must bind a JSON verifier artifact with schema anra-x1-real-1-verifier/v1; its task, intervention, repaired label, gold hash, raw-output hash, and transformed-prompt hash must match the row, and verifier_receipt_sha256 must equal the artifact file hash."
  },
  "stop_conditions": [
    "stop before predictor training when no eligible subject manifest passes strict identity and readiness",
    "stop before predictor training when intervention basis qualification is not QUALIFIED",
    "stop before reveal when prediction receipt, split manifest, source closure, or intervention registry identity is missing or mismatched",
    "stop analysis when any evaluation cluster is reused across splits or any outcome row is missing",
    "do not promote on raw accuracy, AUPRC without prevalence comparison, Brier without skill, or an oracle-only ceiling",
    "do not train an internalized successor during X1"
  ],
  "next_rung_contract": {
    "status": "FUTURE_ONLY_NOT_AUTHORIZED_BY_THIS_PROTOCOL",
    "launch_condition": "X1 primary and independent replication gates both pass",
    "required_evidence": [
      "verified repair trajectories with evaluator receipts",
      "external assistance removed from raw-core evaluation",
      "raw-core performance improved relative to the frozen parent",
      "intervention lift reduced relative to the assisted condition",
      "earlier capability retained within a preregistered floor"
    ],
    "action_if_condition_fails": "stop and preserve the scoped negative or inconclusive result"
  },
  "decision_table": [
    {"outcome": "NO_ELIGIBLE_CHECKPOINT", "meaning": "engineering prerequisite missing; not a scientific negative"},
    {"outcome": "BASIS_NOT_QUALIFIED", "meaning": "instrument prerequisite missing; not a scientific negative"},
    {"outcome": "RELEASE_MANIFEST_REQUIRED", "meaning": "source release/custody prerequisite missing; not a scientific negative"},
    {"outcome": "ARTIFACT_MISMATCH", "meaning": "identity, phase, split, or evidence-firewall gate failed; not a scientific negative"},
    {"outcome": "INCONCLUSIVE", "meaning": "valid artifacts but frozen power, independence, or replication gate is unresolved"},
    {"outcome": "NOT_SUPPORTED", "meaning": "valid prospective evaluation completed but predictor failed one or more frozen scientific gates"},
    {"outcome": "PRIMARY_GATE_PASS_REPLICATION_PENDING", "meaning": "primary signal cleared but no independent/cross-checkpoint promotion claim is allowed"},
    {"outcome": "SUPPORTED_SCOPED", "meaning": "prospective intervention selection supported only in this tested regime; no internalization or AGI claim"}
  ],
